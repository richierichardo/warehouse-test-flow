# PostgreSQL lokal. Samakan pengaturan Compose dengan DATABASE_URL.
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse_local
POSTGRES_PORT=5433
DATABASE_URL=postgresql://warehouse:warehouse_local@127.0.0.1:5433/warehouse

# Isi dengan URL PostgreSQL khusus tes bernama warehouse_test atau warehouse_test_<suffix>.
TEST_DATABASE_URL=

# Isi setiap secret dengan nilai acak yang berbeda.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
RATE_LIMIT_KEY_SECRET=
TRUSTED_PROXY_MODE=direct

# Aktifkan setelah migrasi dan isi ketiga pasangan email dan password.
SEED_DEMO_ENABLED=false
SEED_EMPLOYEE_EMAIL=
SEED_EMPLOYEE_PASSWORD=
SEED_WAREHOUSE_EMAIL=
SEED_WAREHOUSE_PASSWORD=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
