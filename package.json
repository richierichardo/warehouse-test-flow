{
  "name": "warehouse-office-supplies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --no-file-parallelism tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node --conditions=react-server prisma/seed.ts",
    "limiter:cleanup": "node --conditions=react-server scripts/limiter-cleanup.ts",
    "auth:generate": "auth generate --config scripts/auth-schema.config.ts --adapter prisma --dialect postgresql",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.28",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.28",
    "clsx": "2.1.1",
    "dotenv": "18.0.10",
    "next": "16.4.6",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.10.1",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.28",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "shadcn": "4.23.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
